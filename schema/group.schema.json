{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://data.soccerhub.ng/schema/group.schema.json",
  "type": "object",
  "required": [
    "id",
    "name",
    "order",
    "teams"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "order": {
      "type": "integer"
    },
    "teams": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 4,
      "maxItems": 4
    }
  }
}
