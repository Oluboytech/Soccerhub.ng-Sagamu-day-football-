{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://data.soccerhub.ng/schema/match.schema.json",
  "type": "object",
  "required": [
    "id",
    "round",
    "group_id",
    "match_number",
    "date",
    "kickoff_time",
    "timezone",
    "home_team_id",
    "away_team_id",
    "venue_id",
    "status",
    "score"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "round": {
      "type": "string"
    },
    "group_id": {
      "type": "string"
    },
    "match_number": {
      "type": "integer"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "kickoff_time": {
      "type": "string"
    },
    "timezone": {
      "type": "string"
    },
    "home_team_id": {
      "type": "string"
    },
    "away_team_id": {
      "type": "string"
    },
    "home_team": {
      "type": "string"
    },
    "away_team": {
      "type": "string"
    },
    "venue_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "venue": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "type": "string"
    },
    "score": {
      "type": "object",
      "required": [
        "home",
        "away"
      ],
      "properties": {
        "home": {
          "type": [
            "integer",
            "null"
          ]
        },
        "away": {
          "type": [
            "integer",
            "null"
          ]
        },
        "halftime_home": {
          "type": [
            "integer",
            "null"
          ]
        },
        "halftime_away": {
          "type": [
            "integer",
            "null"
          ]
        },
        "penalties_home": {
          "type": [
            "integer",
            "null"
          ]
        },
        "penalties_away": {
          "type": [
            "integer",
            "null"
          ]
        }
      }
    }
  }
}
