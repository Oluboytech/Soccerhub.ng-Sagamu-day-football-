{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://data.soccerhub.ng/schema/venue.schema.json",
  "type": "object",
  "required": [
    "id",
    "name",
    "status"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "location": {
      "type": [
        "string",
        "null"
      ]
    },
    "city": {
      "type": [
        "string",
        "null"
      ]
    },
    "state": {
      "type": [
        "string",
        "null"
      ]
    },
    "capacity": {
      "type": [
        "integer",
        "null"
      ]
    },
    "surface": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "type": "string"
    }
  }
}
